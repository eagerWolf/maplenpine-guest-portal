# Session (must be at least 32 chars)
NUXT_SESSION_PASSWORD=replace-with-a-secure-32-char-secret-key

# Google OAuth — console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:3000/auth/google (dev), https://guestportal.maplenpine.com/auth/google (prod)
NUXT_OAUTH_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Orchestrator Bearer token
ORCHESTRATOR_API_KEY=replace-with-orchestrator-secret

# Bentral API
BENTRAL_API_KEY=your-bentral-api-key
BENTRAL_PROPERTY_ID=5f7a55304e675f4d
BENTRAL_UNIT_ID_MAPLE=your-maple-unit-id
BENTRAL_UNIT_ID_PINE=your-pine-unit-id

# Email (Resend)
RESEND_API_KEY=re_xxxx
ADMIN_EMAIL_FROM=portal@maplenpine.com
ADMIN_EMAIL_TO=admin@maplenpine.com
GUEST_EMAIL_FROM=dostop@maplenpine.com

# Portal base URL (used in links)
NUXT_PUBLIC_BASE_URL=https://guestportal.maplenpine.com

# Cron expressions (optional — defaults below)
# BENTRAL_HOT_CRON=*/30 * * * *
# BENTRAL_WARM_CRON=0 */5 * * *
# BENTRAL_COLD_CRON=0 3 * * *
