# Copy to .env only in a SEPARATE staging directory with an empty data/.
NUXT_SESSION_PASSWORD=
NUXT_SETTINGS_ENCRYPTION_KEY=
NUXT_PUBLIC_BASE_URL=https://guestportal-staging.example.com
PORTAL_DISABLE_BACKGROUND_TASKS=true
TZ=Europe/Ljubljana
PORT=3002
NITRO_HOST=127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_HEADER=x-forwarded-for
# Empty means no production integrations. Manual actions are still possible.
BENTRAL_API_KEY=
BENTRAL_PROPERTY_ID=
BENTRAL_UNIT_ID_MAPLE=
BENTRAL_UNIT_ID_PINE=
SENDGRID_API_KEY=
ADMIN_EMAIL_FROM=
ADMIN_EMAIL_TO=
GUEST_EMAIL_FROM=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_PUBLIC_GA_ID=

# Staff/admin WhatsApp remains available; guest delivery uses Bentral.
PORTAL_WHATSAPP_ENABLED=true
PORTAL_EMAIL_ENABLED=false
# Bentral support-provided message endpoint; use false to pause guest delivery.
BENTRAL_GUEST_MESSAGES_ENABLED=true
